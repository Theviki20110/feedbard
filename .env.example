# --- Feeds ---
# Path to newline-separated list of RSS/Atom feed URLs. Kept on the data
# volume, not in the repo: it is your configuration, and stays untracked.
FEEDS_LIST_PATH=data/feeds_list.txt
# Root for every generated artefact: the processed-posts DB, episodes,
# covers, figures, shards. See the "On-disk layout" section in README.md.
DATA_DIR=data
# Audiobookshelf book-library root; publishing writes {Author}/{Title}/ here
LIBRARY_DIR=library

# --- External services ---
# ASR service base URL, a Whisper-compatible server (used for the TTS QA
# round-trip in pipeline/audio_renderer.py)
ASR_BASE_URL=https://asr.home.vinzlab.com
# TTS provider — one of: http, polly, voxcpm
TTS_PROVIDER=http
# TTS service base URL (used when TTS_PROVIDER=http or voxcpm)
TTS_BASE_URL=https://chatterbox.home.vinzlab.com
# Predefined voice id on the HTTP TTS server (used when TTS_PROVIDER=http)
TTS_VOICE_ID=Leonardo.wav
# Short language code (e.g. "it", "en") passed to the HTTP TTS server and to
# the ASR QA step above. Derived from TARGET_LANGUAGE; set it only to override
# that derivation.
# TTS_LANGUAGE_CODE=it
# Polly voice id (used when TTS_PROVIDER=polly), default Bianca (it-IT)
POLLY_VOICE_ID=Bianca
# Polly engine — one of: standard, neural, generative, long-form (used when TTS_PROVIDER=polly)
POLLY_ENGINE=generative
# BCP-47 language code for Polly (used when TTS_PROVIDER=polly). Derived from
# TARGET_LANGUAGE; set it only to override that derivation, e.g. to pin a
# regional variant TARGET_LANGUAGE does not name.
# POLLY_LANGUAGE_CODE=it-IT
# Model name for VoxCPM2's OpenAI-compatible endpoint (used when TTS_PROVIDER=voxcpm)
VOXCPM_MODEL=openbmb/VoxCPM2
# Path to a reference wav for voice cloning (used when TTS_PROVIDER=voxcpm).
# Required: without it VoxCPM2's zero-shot path invents a new speaker on
# every call, since the OpenAI-schema "voice" field is ignored unless it
# names a preset actually registered on the server.
VOXCPM_REF_AUDIO=data/myvoice.wav

# --- Narration language ---
# Language every article is translated into and narrated in. The single
# source of truth: the TTS/ASR language codes above are derived from it.
# Accepts an English language name (Italian), a code (it), or a full tag
# (pt-BR). Nothing else needs configuring for a language: there is no word
# list and no symbol table. The voice ids are NOT derived — pair this with a
# voice that speaks the language.
TARGET_LANGUAGE=Italian

# --- LLM provider ---
# One of: anthropic, bedrock, ollama
LLM_PROVIDER=bedrock
# Model id/ARN — format depends on provider (e.g. Bedrock inference profile ARN, Anthropic model name, Ollama tag)
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- AWS (used when LLM_PROVIDER=bedrock, or TTS_PROVIDER=polly) ---
# Named AWS CLI profile with Bedrock access. Local development only: a
# container has no ~/.aws, so there use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_PROFILE=Tower
# AWS region for Bedrock calls, default us-east-1
AWS_REGION=us-east-1

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Ollama server URL, default http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Fetching ---
# Optional. Sent as a Bearer token to huggingface.co only, to raise the
# unauthenticated rate limit that otherwise trips fetcher.py's 429 retries.
HF_TOKEN=

# --- Misc ---
# Log verbosity, default INFO
LOG_LEVEL=INFO

# Host path (or named volume) mounted at /app/data by docker-compose
DATA_VOLUME=./data
LIBRARY_VOLUME=./library
