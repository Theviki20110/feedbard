# --- Feeds ---
# Path to newline-separated list of RSS/Atom feed URLs. Kept on the data
# volume, not in the repo: it is your configuration, and stays untracked.
FEEDS_LIST_PATH=data/feeds_list.txt
# Root for every generated artefact: the processed-posts DB, episodes,
# covers, figures, shards. See the "On-disk layout" section in README.md.
DATA_DIR=data
# Audiobookshelf book-library root; publishing writes {Author}/{Title}/ here
LIBRARY_DIR=library

# --- External services ---
# ASR provider — one of: http, sagemaker
ASR_PROVIDER=http
# ASR service base URL (used when ASR_PROVIDER=http)
ASR_BASE_URL=https://asr.home.vinzlab.com
# SageMaker endpoint name (used when ASR_PROVIDER=sagemaker)
SAGEMAKER_ASR_ENDPOINT_NAME=
# TTS provider — one of: http, sagemaker, polly
TTS_PROVIDER=http
# TTS service base URL (used when TTS_PROVIDER=http)
TTS_BASE_URL=https://chatterbox.home.vinzlab.com
# SageMaker endpoint name (used when TTS_PROVIDER=sagemaker)
SAGEMAKER_TTS_ENDPOINT_NAME=
# Polly voice id (used when TTS_PROVIDER=polly), default Bianca (it-IT)
POLLY_VOICE_ID=Bianca
# Polly engine — one of: standard, neural, generative, long-form (used when TTS_PROVIDER=polly)
POLLY_ENGINE=generative

# --- Narration language ---
# Language every article is translated into and narrated in. Must match a
# lexicon file in assets/lexicons/ (e.g. italian.json), or the scrub falls
# back to English spoken forms for symbols. Pair it with a matching TTS voice.
TARGET_LANGUAGE=Italian

# --- LLM provider ---
# One of: anthropic, bedrock, ollama
LLM_PROVIDER=bedrock
# Model id/ARN — format depends on provider (e.g. Bedrock inference profile ARN, Anthropic model name, Ollama tag)
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- AWS (used when LLM_PROVIDER=bedrock, or TTS_PROVIDER=polly) ---
# Named AWS CLI profile with Bedrock access. Local development only: a
# container has no ~/.aws, so there use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_PROFILE=Tower
# AWS region for Bedrock calls, default us-east-1
AWS_REGION=us-east-1

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Ollama server URL, default http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Misc ---
# Log verbosity, default INFO
LOG_LEVEL=INFO

# Host path (or named volume) mounted at /app/data by docker-compose
DATA_VOLUME=./data
LIBRARY_VOLUME=./library
